## SPDX-License-Identifier: GPL-2.0-only

chip soc/intel/skylake

	# IGD Displays
	register "gfx" = "GMA_STATIC_DISPLAYS(0)"

	register "panel_cfg" = "{
		.up_delay_ms		= 200,
		.down_delay_ms		=  50,
		.cycle_delay_ms		= 500,
		.backlight_on_delay_ms	=   1,
		.backlight_off_delay_ms	= 200,
		.backlight_pwm_hz	= 200,
	}"

	register "deep_s3_enable_ac" = "false"
	register "deep_s3_enable_dc" = "false"
	register "deep_s5_enable_ac" = "false"
	register "deep_s5_enable_dc" = "false"

	register "eist_enable" = "true"
	register "tcc_offset" = "5" # TCC of 95C

	# GPE route
	register "gpe0_dw0" = "GPP_C"
	register "gpe0_dw1" = "GPP_D"
	register "gpe0_dw2" = "GPP_E"

	register "dptf_enable" = "false"

	# FSP Configuration
	register "DspEnable" = "false"
	register "IoBufferOwnership" = "0"
	register "SkipExtGfxScan" = "1"
	register "SaGv" = "SaGv_Enabled"
	register "PmConfigSlpS3MinAssert" = "2"
	register "PmConfigSlpS4MinAssert" = "1"
	register "PmConfigSlpSusMinAssert" = "3"
	register "PmConfigSlpAMinAssert" = "3"

	# PL2 override 25W for tablet cooling
	register "power_limits_config" = "{
		.tdp_pl2_override = 25,
	}"

	device domain 0 on
		device ref igpu		on  end
		device ref sa_thermal	on  end
		device ref imgu		off end # Imaging Unit (ISP 00:05.0) - suspected FSP-S hang
		device ref south_xhci	on
			# coreboot writes PortUsb20Enable/PortUsb30Enable from these
			# arrays; leaving them empty disables every port in the FSP.
			# The wired port set is not known from the available dumps
			# (stock DSDT declares HS01-HS14 / SS01-SS10), so all of them
			# are enabled. OC_SKIP avoids tying a port to a floating
			# over-current pin. Narrow this and assign OC0/OC1 (the two
			# USB2_OCB pads muxed native on stock) once the wiring is known.
			register "usb2_ports" = "{
				[0]  = USB2_PORT_MID(OC_SKIP),
				[1]  = USB2_PORT_MID(OC_SKIP),
				[2]  = USB2_PORT_MID(OC_SKIP),
				[3]  = USB2_PORT_MID(OC_SKIP),
				[4]  = USB2_PORT_MID(OC_SKIP),
				[5]  = USB2_PORT_MID(OC_SKIP),
				[6]  = USB2_PORT_MID(OC_SKIP),
				[7]  = USB2_PORT_MID(OC_SKIP),
				[8]  = USB2_PORT_MID(OC_SKIP),
				[9]  = USB2_PORT_MID(OC_SKIP),
				[10] = USB2_PORT_MID(OC_SKIP),
				[11] = USB2_PORT_MID(OC_SKIP),
				[12] = USB2_PORT_MID(OC_SKIP),
				[13] = USB2_PORT_MID(OC_SKIP),
			}"
			register "usb3_ports" = "{
				[0] = USB3_PORT_DEFAULT(OC_SKIP),
				[1] = USB3_PORT_DEFAULT(OC_SKIP),
				[2] = USB3_PORT_DEFAULT(OC_SKIP),
				[3] = USB3_PORT_DEFAULT(OC_SKIP),
				[4] = USB3_PORT_DEFAULT(OC_SKIP),
				[5] = USB3_PORT_DEFAULT(OC_SKIP),
				[6] = USB3_PORT_DEFAULT(OC_SKIP),
				[7] = USB3_PORT_DEFAULT(OC_SKIP),
				[8] = USB3_PORT_DEFAULT(OC_SKIP),
				[9] = USB3_PORT_DEFAULT(OC_SKIP),
			}"
		end
		device ref south_xdci	off end
		device ref thermal	on  end
		device ref cio		off end # CSI-2 camera host (00:14.3) - suspected FSP-S hang
		device ref i2c0		on  end # Bosch BOSC0200 accelerometer (0x18), touchpad slot
		device ref i2c1		on  end # Wacom WCOM508C touchscreen/pen digitizer (0x4C)
		device ref i2c2		on  end
		device ref i2c3		on  end # Semtech SX9500F1 proximity/SAR sensor
		device ref uart2	on  end # JUART1 debug console (GPP_C20/C21)
		device ref heci1	on  end
		device ref sata		off end # no SATA on Miix 510; suspected FSP-S hang
		# The stock firmware exposes the WLAN behind the root port at 00:1c.0
		# (PCH-LP ports are numbered from 1 at 1c.0), not 1c.3.
		device ref pcie_rp1	on  end # Intel Wireless 7260
		device ref pcie_rp9	on  end # Samsung NVMe SSD (00:1d.0)
		device ref lpc_espi	on
			register "serirq_mode" = "SERIRQ_CONTINUOUS"
			# ITE IT85xx EC is reachable over LPC at 0x62/0x66 (ACPI EC
			# interface, see DSDT H_EC._CRS) plus its SuperIO-style
			# configuration window and the KBC range. Without these the
			# PCH does not forward the ports to the EC and the ACPI EC
			# driver in the OS times out on every transaction.
			register "lpc_ioe" = "LPC_IOE_EC_62_66 |
					      LPC_IOE_KBC_60_64 |
					      LPC_IOE_EC_4E_4F"
			register "gen1_dec" = "LPC_IO(0x380, 0x4)"
			register "gen2_dec" = "LPC_IO(0x68, 0x8)"
		end
		device ref hda		on  end # Realtek ALC269VC
		device ref smbus	on  end
		device ref fast_spi	on  end
	end
end
