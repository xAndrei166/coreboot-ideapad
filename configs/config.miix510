CONFIG_VENDOR_LENOVO=y
CONFIG_BOARD_LENOVO_MIIX_510=y
CONFIG_USE_BLOBS=y
CONFIG_HAVE_IFD_BIN=y
CONFIG_IFD_BIN_PATH="../blobs/flashregion_0_flashdescriptor.bin"
CONFIG_HAVE_ME_BIN=y
CONFIG_ME_BIN_PATH="../blobs/flashregion_2_intel_me.bin"
CONFIG_FSP_USE_REPO=y
CONFIG_FSP_PACKAGE_DEFAULT=y
CONFIG_ANY_TOOLCHAIN=y
CONFIG_DO_NOT_TOUCH_DESCRIPTOR_REGION=y
CONFIG_PAYLOAD_EDK2=y
CONFIG_EDK2_SERIAL_SUPPORT=y
# CONFIG_SMMSTORE is not set
CONFIG_CONSOLE_SPI_FLASH=y
CONFIG_CONSOLE_SPI_FLASH_BUFFER_SIZE=0x20000
CONFIG_CONSOLE_SERIAL=y
CONFIG_CONSOLE_SERIAL_115200=y
CONFIG_MAINBOARD_USE_LIBGFXINIT=y
CONFIG_DEFAULT_CONSOLE_LOGLEVEL_4=y
